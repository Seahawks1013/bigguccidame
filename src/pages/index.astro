---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SpotifyEmbed from '../components/SpotifyEmbed.astro';
import { latestRelease, links, path, socials } from '../data/site';

import hero from '../assets/hero.webp';
import birdsCover from '../assets/birds-of-a-feather.webp';
import embed from '../assets/embed.webp';
import vidBirds from '../assets/vid-birds-of-a-feather.webp';
import vidOldLens from '../assets/vid-old-lens.webp';
import vidConqueror from '../assets/vid-more-than-a-conqueror.webp';

const dspClass = { spotify: 'dsp-sp', apple: 'dsp-ap', ytmusic: 'dsp-ytm', amazon: 'dsp-am', tidal: 'dsp-td', youtube: 'dsp-yt' } as const;

const videos = [
  { title: 'BIRDS OF A FEATHER', href: 'https://www.youtube.com/watch?v=7SQF61AXT0c', img: vidBirds },
  { title: 'OLD LENS (OFFICIAL AUDIO)', href: 'https://youtu.be/iZHu29luOnw', img: vidOldLens },
  { title: 'MORE THAN A CONQUEROR', href: 'https://www.youtube.com/watch?v=4iR8LrS0Qj0', img: vidConqueror },
  { title: 'View All Videos →', href: links.youtubeChannel, img: embed, alt: 'View All Videos' },
];
---
<BaseLayout
  title="BigGucciDame - Official Site"
  description="BigGucciDame. WAVES out now on all platforms. New single Birds of a Feather. 12M+ streams. Florida Christian Hip-Hop."
  ogDescription="WAVES is out now. 12M+ streams. Faith-driven rap from Florida."
  active="waves"
  isHome
>
  <main>
    <!-- HERO -->
    <section class="hero" id="hero">
      <div class="hero-port">
        <Image src={hero} alt="BigGucciDame" widths={[640, 1024, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
      </div>
      <div class="hero-cnt">
        <p class="hero-pre enter">Florida · Christian Hip-Hop · 12M+ Streams</p>
        <h1 class="hero-title enter-2">Big<span class="grad-text">Gucci</span>Dame</h1>
        <div class="hero-cta enter-3">
          <a href={links.wavesSpotify} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <Icon name="spotify" /> Listen on Spotify
          </a>
          <a href="#song" class="btn btn-ghost">New: {latestRelease.title}</a>
        </div>
      </div>
    </section>

    <!-- WAVES — OUT NOW -->
    <section class="waves-sec" id="waves">
      <div class="waves-inner">
        <span class="waves-label rv">New Album · Out Now</span>
        <h2 class="waves-big rv d1">WAVES</h2>
        <p class="waves-date rv d2">Released <span>July 17, 2026</span> · 9 Tracks</p>
        <div class="waves-btns rv d3">
          <a href={links.wavesSpotify} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <Icon name="spotify" size={22} /> Listen on Spotify
          </a>
          <a href={path('/songs/')} class="btn btn-ghost">Tracklist &amp; Stories</a>
        </div>
      </div>
    </section>

    <!-- FEATURED TRACK -->
    <section class="song-sec" id="song">
      <div class="song-grid">
        <div class="cover-wrap rv rv-scale">
          <Image src={birdsCover} alt={`${latestRelease.title} cover art`} widths={[320, 640]} sizes="(max-width: 767px) 100vw, 50vw" />
        </div>

        <div>
          <h2 class="sec-lbl rv" data-n="01.">Featured Track</h2>
          <p class="song-title rv d1"><span class="grad-text">BIRDS</span> OF A FEATHER</p>
          <p class="song-sub rv d2">{latestRelease.artists} · {latestRelease.year} · Out Now</p>
          <div class="dsp-grid rv d3">
            {latestRelease.links.map((d) => (
              <a href={d.href} target="_blank" rel="noopener noreferrer" class={`dsp ${dspClass[d.name]}`}>
                <Icon name={d.name} /> {d.label}
              </a>
            ))}
          </div>
          <div class="rv d4">
            <SpotifyEmbed type="album" id={latestRelease.spotifyAlbumId} title={latestRelease.title} compact />
          </div>
        </div>
      </div>
    </section>

    <!-- MUSIC -->
    <section class="music-sec" id="music">
      <div class="music-inner">
        <h2 class="sec-lbl rv" data-n="02.">Music</h2>
        <div class="rv rv-scale">
          <SpotifyEmbed type="album" id="61OHhCOsd0YzmaDvowbCq5" title="WAVES" />
        </div>
        <div class="stream-links rv">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" class="sl"><Icon name={s.name} size={22} /> {s.label}</a>
          ))}
        </div>
      </div>
    </section>

    <!-- VIDEOS -->
    <section class="vid-sec" id="videos">
      <div class="vid-head">
        <h2 class="sec-lbl rv" data-n="03.">Videos</h2>
        <p class="vid-sub rv">Latest visuals &amp; releases</p>
      </div>
      <div class="vid-scroll">
        {videos.map((v, i) => (
          <div class={`vid-card rv rv-scale d${i + 1}`}>
            <a href={v.href} target="_blank" rel="noopener noreferrer" class="vid-link">
              <span class="vid-frame">
                <Image src={v.img} alt={v.alt ?? v.title} class="vid-thumb" widths={[360, 480]} sizes="(max-width: 767px) 260px, 360px" />
                <span class="vid-play" aria-hidden="true"><svg viewBox="0 0 68 48" width="60" height="42"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.420 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.950 68 24 68 24s-.06-10.95-1.48-16.26z" fill="rgba(255,255,255,0.9)"/><path d="M45 24L27 14v20" fill="#050d1e"/></svg></span>
              </span>
              <span class="vid-ttl">{v.title}</span>
            </a>
          </div>
        ))}
      </div>
      <div class="vid-cta rv">
        <a href={links.youtubeChannel} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">View All on YouTube</a>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="about-sec" id="about">
      <div class="about-grid">
        <div>
          <h2 class="sec-lbl rv" data-n="04.">About</h2>
          <h3 class="ah rv"><span class="grad-text">Faith as the<br />Foundation</span></h3>
          <p class="ab rv">BigGucciDame is an independent Florida artist blending melodic rap, transparent storytelling, and Christ-centered themes. Through consistency and an expanding catalog, he's emerged as a rising voice in Christian hip-hop with over 12 million streams across platforms.</p>
          <p class="ab rv">Known for records like "God Provides," "Rich in Christ," and "Road to Heaven" — his music hits hard while staying rooted in authenticity, ambition, and perseverance.</p>
          <div class="stats rv">
            <div><div class="sn grad-text">12M+</div><div class="sl2">Total Streams</div></div>
            <div><div class="sn grad-text">40K</div><div class="sl2">Monthly Listeners</div></div>
            <div><div class="sn grad-text">774K</div><div class="sl2">Rich in Christ</div></div>
          </div>
        </div>
        <blockquote class="qblock rv rv-scale d2">
          <span class="qmark" aria-hidden="true">"</span>
          <p class="qtext">Faith serves as both the foundation and driving force. Building a catalog rooted in substance, intention, and impact.</p>
          <cite class="qattr">— BigGucciDame</cite>
        </blockquote>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-sec">
      <div class="cta-inner">
        <p class="cta-h rv">Ride the wave</p>
        <p class="cta-s rv d1">WAVES is out now · 9 tracks · stream it everywhere.</p>
        <div class="rv rv-scale d2">
          <a href={links.wavesSpotify} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <Icon name="spotify" /> Listen on Spotify
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  /* HERO */
  .hero { position:relative; min-height:100svh; display:flex; align-items:flex-end; padding:0 var(--pad-x) clamp(60px,8vw,100px); overflow:hidden; isolation:isolate; }
  .hero-port { position:absolute; inset:0; z-index:-1; animation:settle 2.4s var(--ease) both; }
  .hero-port img { width:100%; height:100%; object-fit:cover; object-position:center top; }
  .hero-port::after { content:''; position:absolute; inset:0; background:linear-gradient(to bottom,rgba(7,9,14,.2) 0%,rgba(7,9,14,0) 25%,rgba(7,9,14,.72) 65%,var(--bg) 100%); }
  .hero-cnt  { max-width:860px; }
  .hero-pre  { font-family:var(--mono); font-size:.72rem; letter-spacing:.22em; text-transform:uppercase; color:var(--blue-lt); margin-bottom:14px; }
  .hero-title { font-size:clamp(2.6rem,9vw,8.5rem); font-weight:900; line-height:1; letter-spacing:-.02em; text-transform:uppercase; margin-bottom:36px; color:var(--white); }
  .hero-cta  { display:flex; gap:14px; flex-wrap:wrap; }

  /* WAVES */
  .waves-sec { background:radial-gradient(ellipse 80% 60% at 50% 45%,rgba(58,96,128,.22),transparent 70%),linear-gradient(180deg,var(--bg) 0%,var(--navy) 45%,var(--bg2) 100%); padding:clamp(90px,12vw,160px) var(--pad-x); text-align:center; }
  .waves-inner { max-width:720px; margin:0 auto; }
  .waves-label { font-family:var(--mono); font-size:.72rem; letter-spacing:.25em; text-transform:uppercase; color:var(--blue-lt); margin-bottom:20px; display:block; }
  .waves-big { font-size:clamp(3.5rem,14vw,11rem); font-weight:900; letter-spacing:.04em; line-height:1; background:linear-gradient(180deg,#fff 0%,var(--ice) 35%,var(--blue-lt) 65%,var(--blue) 100%); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; margin-bottom:24px; }
  .waves-date { font-family:var(--mono); font-size:.85rem; letter-spacing:.2em; color:var(--text-dim); text-transform:uppercase; margin-bottom:40px; }
  .waves-date span { color:var(--white); font-weight:600; }
  .waves-btns { display:flex; flex-wrap:wrap; gap:14px; justify-content:center; }

  /* FEATURED */
  .song-sec { padding:clamp(70px,9vw,120px) var(--pad-x); background:var(--bg2); }
  .song-grid { max-width:1200px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:clamp(40px,6vw,100px); align-items:center; }
  .cover-wrap { border-radius:8px; overflow:hidden; box-shadow:0 30px 80px rgba(0,0,0,.6); aspect-ratio:1; background:var(--navy); }
  .cover-wrap img { width:100%; height:100%; object-fit:cover; }
  .song-title { font-size:clamp(2.2rem,4.5vw,4rem); font-weight:900; line-height:1; color:var(--white); margin-bottom:12px; letter-spacing:-.02em; }
  .song-sub { font-family:var(--mono); font-size:.75rem; letter-spacing:.12em; color:var(--text-dim); text-transform:uppercase; margin-bottom:32px; }
  .dsp-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:24px; }
  .dsp { display:flex; align-items:center; justify-content:center; gap:10px; padding:13px 14px; border-radius:6px; font-size:.8rem; font-weight:600; transition:transform .25s var(--ease); }
  .dsp:hover { transform:translateY(-2px); }
  .dsp-sp { background:#1DB954; color:#fff; }
  .dsp-ap { background:#000; color:#fff; border:1px solid rgba(255,255,255,.14); }
  .dsp-yt { background:#FF0000; color:#fff; }
  .dsp-ytm { background:#212121; color:#fff; border:1px solid rgba(255,0,0,.45); }
  .dsp-am { background:#232F3E; color:#25D1DA; }
  .dsp-td { background:#fff; color:#000; }

  /* MUSIC */
  .music-sec { padding:clamp(80px,10vw,140px) var(--pad-x); background:var(--bg); }
  .music-inner { max-width:1100px; margin:0 auto; }
  .stream-links { display:flex; gap:24px; flex-wrap:wrap; margin-top:32px; }
  .sl { display:flex; align-items:center; gap:8px; font-size:.8rem; font-weight:500; color:var(--text-dim); transition:color .2s; }
  .sl:hover { color:var(--blue-lt); }

  /* VIDEOS */
  .vid-sec { padding:clamp(80px,10vw,140px) 0; background:var(--bg2); }
  .vid-head { padding:0 var(--pad-x); max-width:1200px; margin:0 auto 48px; }
  .vid-head .sec-lbl { margin-bottom:8px; }
  .vid-sub { font-size:.88rem; color:var(--text-dim); }
  .vid-scroll { display:flex; gap:18px; padding:0 var(--pad-x) 4px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; max-width:1200px; margin:0 auto; }
  .vid-scroll::-webkit-scrollbar { display:none; }
  .vid-card { flex-shrink:0; width:clamp(260px,28vw,360px); border-radius:8px; overflow:hidden; background:var(--navy); border:1px solid var(--border); scroll-snap-align:start; }
  .vid-link { display:block; }
  .vid-frame { display:block; position:relative; overflow:hidden; aspect-ratio:16/9; }
  .vid-thumb { width:100%; height:100%; object-fit:cover; transition:transform .6s var(--ease); }
  .vid-card:hover .vid-thumb { transform:scale(1.05); }
  .vid-play { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; opacity:0; transition:opacity .3s; }
  .vid-card:hover .vid-play { opacity:1; }
  .vid-ttl { display:block; padding:12px 14px; font-size:.78rem; font-weight:600; letter-spacing:.04em; text-transform:uppercase; color:var(--text-dim); transition:color .2s; }
  .vid-card:hover .vid-ttl { color:var(--blue-lt); }
  .vid-cta { padding:44px var(--pad-x) 0; max-width:1200px; margin:0 auto; }

  /* ABOUT */
  .about-sec { padding:clamp(80px,10vw,140px) var(--pad-x); background:var(--bg); }
  .about-grid { max-width:1100px; margin:0 auto; display:grid; grid-template-columns:1fr 1.1fr; gap:clamp(40px,6vw,90px); align-items:center; }
  .ah { font-size:clamp(1.8rem,3.5vw,3rem); font-weight:900; line-height:1.1; letter-spacing:-.02em; margin-bottom:20px; }
  .ab { font-size:.97rem; line-height:1.75; color:var(--text); margin-bottom:18px; }
  .stats { display:flex; gap:36px; margin-top:36px; flex-wrap:wrap; }
  .sn { font-size:2rem; font-weight:700; line-height:1.1; margin-bottom:4px; }
  .sl2 { font-family:var(--mono); font-size:.68rem; letter-spacing:.1em; text-transform:uppercase; color:var(--text-dim); }
  .qblock { background:linear-gradient(135deg,rgba(58,96,128,.08),rgba(58,96,128,.02)); border:1px solid rgba(58,96,128,.2); border-radius:8px; padding:clamp(28px,4vw,48px); }
  .qmark { font-size:5rem; line-height:.5; color:var(--blue-lt); opacity:.25; font-family:Georgia,serif; margin-bottom:18px; display:block; }
  .qtext { font-size:clamp(1rem,1.8vw,1.3rem); font-style:italic; line-height:1.65; color:var(--text); margin-bottom:14px; }
  .qattr { font-family:var(--mono); font-style:normal; font-size:.68rem; letter-spacing:.15em; text-transform:uppercase; color:var(--blue-lt); }

  /* CTA */
  .cta-sec { padding:clamp(80px,10vw,140px) var(--pad-x); background:radial-gradient(ellipse 60% 60% at 50% 50%,rgba(45,107,228,.1),transparent 70%),var(--navy); text-align:center; }
  .cta-inner { max-width:580px; margin:0 auto; }
  .cta-h { font-size:clamp(1.5rem,3vw,2.2rem); font-weight:700; color:var(--white); margin-bottom:10px; letter-spacing:-.02em; }
  .cta-s { font-size:.9rem; color:var(--text-dim); margin-bottom:32px; }

  @media (max-width:767px) {
    .hero-title { white-space:normal; text-align:center; }
    .hero-pre { text-align:center; letter-spacing:.1em; font-size:.65rem; }
    .hero-cta { justify-content:center; }
    .song-grid, .about-grid { grid-template-columns:1fr; }
    .qblock { display:none; }
    .dsp-grid { grid-template-columns:1fr; }
    .waves-btns .btn { width:100%; justify-content:center; }
  }
</style>
