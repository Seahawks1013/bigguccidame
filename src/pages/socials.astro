---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SpotifyEmbed from '../components/SpotifyEmbed.astro';
import { latestRelease, links, path } from '../data/site';

import hero from '../assets/hero.webp';

const profiles = [
  { name: 'spotify', label: 'Spotify', href: links.spotifyArtist },
  { name: 'apple', label: 'Apple Music', href: links.appleArtist },
  { name: 'youtube', label: 'YouTube', href: links.youtubeChannel },
  { name: 'instagram', label: 'Instagram', href: links.instagram },
  { name: 'tiktok', label: 'TikTok', href: links.tiktok },
  // SoundCloud + booking live only on this page
  { name: 'soundcloud', label: 'SoundCloud', href: 'https://soundcloud.com/user-325897329' },
] as const;

const moreLinks = [
  { label: 'Book BigGucciDame', sub: 'Send a booking request', href: 'https://docs.google.com/forms/d/e/1FAIpQLSftHyndC9D9y6tiphCccs-SCDB67Fp2aaLM3u68kBsYxfWbkw/viewform', external: true, booking: true },
  { label: 'WAVES — the album', sub: 'Out now on Spotify', href: links.wavesSpotify, external: true },
  { label: 'Tracklist & stories', sub: 'The story behind every song', href: path('/songs/') },
  { label: 'Official website', sub: 'Music, videos & more', href: path('/') },
];
---
<BaseLayout
  title="BigGucciDame — Links"
  description={`New single "${latestRelease.title}" out now. Stream it and follow BigGucciDame everywhere.`}
  ogImage="https://i.scdn.co/image/ab67616d0000b273659611b15c5ff43338e8048c"
  bare
>
  <main class="lk">
    <!-- PHOTO -->
    <div class="lk-photo">
      <Image src={hero} alt="" widths={[640, 960, 1280]} sizes="(max-width: 767px) 100vw, 50vw" loading="eager" fetchpriority="high" />
      <div class="lk-photo-cnt" aria-hidden="true">
        <p class="lk-photo-name enter">BigGucciDame</p>
        <p class="lk-photo-meta enter-2">Artist · <span>Florida</span></p>
      </div>
    </div>

    <!-- CONTENT -->
    <div class="lk-main">
      <header class="lk-head">
        <h1 class="lk-name enter">BigGucciDame</h1>
        <p class="lk-tag enter-2">Faith-driven rap from Florida · 12M+ streams</p>
        <ul class="lk-icons enter-3">
          {profiles.map((p) => (
            <li><a href={p.href} target="_blank" rel="noopener noreferrer" aria-label={p.label} title={p.label}><Icon name={p.name} /></a></li>
          ))}
        </ul>
      </header>

      <section aria-labelledby="rel-h">
        <h2 class="lk-lbl" id="rel-h">Latest Release <span class="lk-new">New</span></h2>
        <article class="rel">
          <!-- Spotify's player shows the cover, title and artists, so no separate header -->
          <div class="rel-player">
            <SpotifyEmbed type="track" id={latestRelease.spotifyTrackId} title={latestRelease.title} compact eager />
          </div>
          <div class="rel-links">
            {latestRelease.links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener noreferrer" class={`rel-btn rel-${l.name}`}>
                <Icon name={l.name} size={18} />
                <span>{l.label}</span>
                <span class="rel-go">{l.name === 'youtube' ? 'Watch' : 'Play'}</span>
              </a>
            ))}
          </div>
        </article>
      </section>

      <section aria-labelledby="links-h">
        <h2 class="lk-lbl" id="links-h">Links</h2>
        <ul class="more">
          {moreLinks.map((l, i) => (
            <li class={`rv d${i + 1}`}>
              <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})} class:list={['more-a', { 'more-booking': 'booking' in l }]}>
                <span class="more-ico" aria-hidden="true">
                  {'booking' in l
                    ? <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M9 16l2 2 4-4"/></svg>
                    : <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>}
                </span>
                <span class="more-txt"><span class="more-label">{l.label}</span><span class="more-sub">{l.sub}</span></span>
                <svg class="more-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <footer class="lk-foot">© 2026 BigGucciDame</footer>
    </div>
  </main>
</BaseLayout>

<style is:global>
  .lk { display:grid; grid-template-columns:1fr 1fr; min-height:100svh; background:radial-gradient(ellipse 90% 60% at 100% 100%,rgba(58,96,128,.25),transparent 70%),var(--bg); }

  /* PHOTO */
  .lk-photo { position:sticky; top:0; height:100svh; overflow:hidden; isolation:isolate; }
  .lk-photo img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center top; z-index:-1; animation:settle 2.4s var(--ease) both; }
  .lk-photo::after { content:''; position:absolute; inset:0; z-index:-1; background:linear-gradient(to bottom,rgba(7,9,14,0) 45%,rgba(7,9,14,.85) 88%,var(--bg) 100%); }
  .lk-photo-cnt { position:absolute; left:clamp(24px,4vw,56px); right:24px; bottom:clamp(28px,4vw,48px); }
  .lk-photo-name { font-size:clamp(2.4rem,5.5vw,5rem); font-weight:900; line-height:.95; letter-spacing:-.03em; color:#fff; margin-bottom:12px; }
  .lk-photo-meta { font-size:.85rem; font-weight:600; color:var(--text); }
  .lk-photo-meta span { color:var(--text-dim); font-weight:500; }

  /* CONTENT */
  .lk-main { padding:clamp(40px,6vw,72px) clamp(24px,4vw,56px) 40px; display:flex; flex-direction:column; gap:40px; max-width:720px; width:100%; }
  .lk-name { font-size:clamp(2.2rem,4vw,3.4rem); font-weight:900; letter-spacing:-.03em; line-height:1; color:var(--white); margin-bottom:10px; }
  .lk-tag { font-size:.92rem; color:var(--text); margin-bottom:24px; }
  .lk-icons { list-style:none; display:flex; flex-wrap:wrap; gap:10px; }
  .lk-icons a { width:48px; height:48px; display:grid; place-items:center; border-radius:12px; border:1px solid rgba(255,255,255,.14); background:rgba(255,255,255,.03); color:var(--white); transition:transform .25s var(--ease), border-color .2s, color .2s; }
  .lk-icons a:hover { transform:translateY(-3px); border-color:var(--blue-lt); color:var(--blue-lt); }

  .lk-lbl { font-family:var(--mono); font-size:.7rem; font-weight:500; letter-spacing:.2em; text-transform:uppercase; color:var(--text-dim); margin-bottom:14px; display:flex; align-items:center; gap:10px; }
  .lk-lbl::after { content:''; flex:1; height:1px; background:var(--border); }
  .lk-new { font-size:.6rem; letter-spacing:.15em; padding:3px 8px; border-radius:20px; color:#07090e; background:var(--blue-lt); }

  /* RELEASE CARD — pops in on load */
  @keyframes pop {
    0%   { opacity:0; transform:translateY(24px) scale(.92); }
    60%  { opacity:1; transform:translateY(-4px) scale(1.015); }
    100% { opacity:1; transform:none; }
  }
  @keyframes sheen { from { transform:translateX(-120%) skewX(-20deg); } to { transform:translateX(320%) skewX(-20deg); } }
  .rel { position:relative; overflow:hidden; border-radius:18px; padding:18px; border:1px solid rgba(122,176,212,.28); background:linear-gradient(160deg,rgba(28,45,66,.75),rgba(13,21,32,.9)); box-shadow:0 20px 60px rgba(0,0,0,.45), 0 0 0 1px rgba(255,255,255,.03) inset; animation:pop .9s var(--ease) .35s both; }
  .rel::after { content:''; position:absolute; top:0; bottom:0; left:0; width:35%; background:linear-gradient(90deg,transparent,rgba(200,224,240,.12),transparent); pointer-events:none; transform:translateX(-120%) skewX(-20deg); animation:sheen 1.4s ease-in-out 1.1s 1 both; }
  .rel-player { margin-bottom:12px; border-radius:12px; overflow:hidden; }


  /* Spotify full-width as the main action, the rest in two columns */
  .rel-links { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
  .rel-links .rel-spotify { grid-column:1 / -1; }
  .rel-links .rel-btn:not(.rel-spotify) .rel-go { display:none; }
  .rel-btn { display:flex; align-items:center; gap:12px; padding:14px 16px; border-radius:12px; background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.07); color:var(--white); font-size:.9rem; font-weight:600; transition:transform .25s var(--ease), background-color .2s, border-color .2s; }
  .rel-btn:hover { transform:translateY(-2px); background:rgba(255,255,255,.07); }
  .rel-spotify svg { color:#1DB954; }
  .rel-apple svg { color:#fa2d48; }
  .rel-youtube svg, .rel-ytmusic svg { color:#ff0000; }
  .rel-amazon svg { color:#25D1DA; }
  .rel-tidal svg { color:#fff; }
  .rel-go { margin-left:auto; font-family:var(--mono); font-size:.65rem; letter-spacing:.14em; text-transform:uppercase; color:var(--text-dim); transition:color .2s; }
  .rel-btn:hover .rel-go { color:var(--blue-lt); }
  .rel-spotify { background:rgba(29,185,84,.12); border-color:rgba(29,185,84,.3); }
  .rel-spotify:hover { background:rgba(29,185,84,.2); }

  /* MORE LINKS */
  .more { list-style:none; display:grid; gap:10px; }
  .more-a { display:flex; align-items:center; gap:14px; padding:14px 16px; border-radius:14px; border:1px solid var(--border); background:rgba(13,21,32,.6); transition:border-color .2s, transform .25s var(--ease); }
  .more-a:hover { border-color:rgba(122,176,212,.4); transform:translateY(-2px); }
  .more-booking { border-color:rgba(122,176,212,.35); background:linear-gradient(135deg,rgba(58,96,128,.28),rgba(13,21,32,.6)); }
  .more-booking .more-ico { background:var(--blue-lt); color:var(--bg); }
  .more-booking .more-label { color:var(--white); }
  .more-ico { width:38px; height:38px; display:grid; place-items:center; border-radius:50%; background:rgba(122,176,212,.1); color:var(--blue-lt); flex-shrink:0; }
  .more-txt { display:flex; flex-direction:column; gap:2px; min-width:0; }
  .more-label { color:var(--blue-lt); font-weight:600; font-size:.98rem; }
  .more-sub { color:var(--text-dim); font-size:.78rem; }
  .more-arrow { margin-left:auto; color:var(--text-dim); transition:transform .25s var(--ease), color .2s; flex-shrink:0; }
  .more-a:hover .more-arrow { transform:translate(2px,-2px); color:var(--blue-lt); }

  .lk-foot { margin-top:auto; font-family:var(--mono); font-size:.7rem; letter-spacing:.08em; color:var(--text-dim); text-align:center; }

  @media (max-width:767px) {
    .lk { grid-template-columns:1fr; }
    /* short banner so the release card is visible without scrolling */
    .lk-photo { position:relative; height:42svh; min-height:280px; }
    .lk-photo-name { font-size:2.4rem; }
    .lk-main { padding:8px 20px 32px; gap:32px; margin:0 auto; }
    /* name is already on the photo; keep the h1 for screen readers only */
    .lk-name { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
    .lk-tag { margin-bottom:18px; }
    /* all profile icons share one row */
    .lk-icons { display:grid; grid-template-columns:repeat(auto-fit,minmax(40px,1fr)); gap:8px; }
    .lk-icons a { width:100%; }
  }
</style>
