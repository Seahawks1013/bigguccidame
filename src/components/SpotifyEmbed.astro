---
// Click-to-load Spotify player. The real iframe (and Spotify's heavy JS)
// only loads after the visitor taps, so the page stays light.
import Icon from './Icon.astro';

interface Props {
  type: 'album' | 'track' | 'artist';
  id: string;
  title: string;
  /** compact = 152px player, otherwise 352px */
  compact?: boolean;
}
const { type, id, title, compact = false } = Astro.props;
const src = `https://open.spotify.com/embed/${type}/${id}?utm_source=generator&theme=0`;
---
<div class:list={['sp-embed', { 'sp-compact': compact }]} data-src={src} data-title={title}>
  <button type="button" class="sp-load">
    <span class="sp-play"><Icon name="spotify" size={26} /></span>
    <span class="sp-txt">
      <span class="sp-ttl">Play {title}</span>
      <span class="sp-sub">Loads the Spotify player</span>
    </span>
  </button>
</div>

<style is:global>
  .sp-embed { height:352px; border-radius:12px; overflow:hidden; background:linear-gradient(135deg,#0f1a26,#0a111b); border:1px solid var(--border); }
  .sp-embed.sp-compact { height:152px; }
  .sp-embed iframe { width:100%; height:100%; border:0; display:block; }
  .sp-load { width:100%; height:100%; display:flex; align-items:center; justify-content:center; gap:16px; background:none; border:0; color:var(--white); font:inherit; cursor:pointer; text-align:left; }
  .sp-play { width:56px; height:56px; border-radius:50%; background:#1DB954; color:#fff; display:grid; place-items:center; flex-shrink:0; transition:transform .3s var(--ease); }
  .sp-load:hover .sp-play { transform:scale(1.08); }
  .sp-txt { display:flex; flex-direction:column; gap:4px; }
  .sp-ttl { font-weight:700; font-size:.95rem; }
  .sp-sub { font-family:var(--mono); font-size:.65rem; letter-spacing:.12em; text-transform:uppercase; color:var(--text-dim); }
</style>
