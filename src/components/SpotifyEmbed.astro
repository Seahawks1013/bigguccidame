---
// Native Spotify player. `loading="lazy"` keeps it (and Spotify's JS) from
// loading until it's scrolled near, so the top of the page stays fast.
interface Props {
  type: 'album' | 'track' | 'artist';
  id: string;
  title: string;
  /** compact = 152px player, otherwise 352px */
  compact?: boolean;
  /** slim = 80px play bar (works best with a track) */
  slim?: boolean;
  /** load right away (use when the player is visible on first screen) */
  eager?: boolean;
}
const { type, id, title, compact = false, slim = false, eager = false } = Astro.props;
const src = `https://open.spotify.com/embed/${type}/${id}?utm_source=generator&theme=0`;
---
<iframe
  class:list={['sp-embed', { 'sp-compact': compact, 'sp-slim': slim }]}
  src={src}
  title={`${title} on Spotify`}
  loading={eager ? 'eager' : 'lazy'}
  allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
  referrerpolicy="strict-origin-when-cross-origin"
></iframe>

<style is:global>
  .sp-embed { display:block; width:100%; height:352px; border:0; border-radius:12px; background:var(--navy); }
  .sp-embed.sp-compact { height:152px; }
  .sp-embed.sp-slim { height:80px; }
</style>
